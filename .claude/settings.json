{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Write|Edit",
        "hooks": [
          {
            "type": "command",
            "command": ".claude/scripts/check-doc-size.sh",
            "timeout": 5,
            "statusMessage": "Checking doc size limits..."
          }
        ]
      }
    ]
  }
}
